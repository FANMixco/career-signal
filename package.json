{
  "name": "career-signal-engine-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "Desktop wrapper for Career Signal Engine.",
  "author": "Federico Navarrete",
  "main": "desktop/main.cjs",
  "scripts": {
    "version:sync": "node scripts/sync-version.cjs",
    "desktop:setup": "npm install && npm --prefix backend install",
    "desktop:prepare": "npm run version:sync && npm --prefix backend run build",
    "desktop:build": "npm run desktop:dist",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:pack": "npm run desktop:prepare && electron-builder --win --dir --publish=never",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win --publish=never",
    "desktop:dist:arm64": "npm run desktop:prepare && electron-builder --win --arm64 --publish=never",
    "desktop:dist:mac": "npm run desktop:prepare && electron-builder --mac dmg zip --publish=never"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.federiconavarrete.careersignal",
    "productName": "Career Signal Engine",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "backend/dist/**/*",
      "backend/node_modules/**/*",
      "backend/package.json",
      "frontend/**/*",
      "sample/**/*",
      "!**/*.md",
      "!LICENSE",
      "!LICENSE.*",
      "!COPYING",
      "!COPYING.*"
    ],
    "win": {
      "icon": "frontend/img/favicons/android-chrome-512x512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
