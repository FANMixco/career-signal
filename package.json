{
  "name": "career-signal-engine-desktop",
  "version": "1.0.8",
  "private": true,
  "description": "Desktop wrapper for Career Signal Engine.",
  "author": "Federico Navarrete",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:prepare": "npm --prefix backend run build",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:pack": "npm run desktop:prepare && electron-builder --win --dir --publish=never",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win --publish=never",
    "desktop:dist:arm64": "npm run desktop:prepare && electron-builder --win --arm64 --publish=never",
    "desktop:store": "npm run desktop:prepare && electron-builder --win appx --config electron-builder.store.cjs --publish=never",
    "desktop:store:local": "powershell -ExecutionPolicy Bypass -File scripts/build-store-app.ps1"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.federiconavarrete.careersignal",
    "productName": "Career Signal Engine",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "backend/dist/**/*",
      "backend/node_modules/**/*",
      "backend/package.json",
      "frontend/**/*",
      "LICENSE"
    ],
    "win": {
      "icon": "frontend/img/favicons/android-chrome-512x512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
